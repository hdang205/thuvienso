# Production Environment Variables
# 
# Copy this file to .env.production and fill in all required values
# NEVER commit .env.production to version control!
#
# For Railway deployment:
# 1. Set these as Railway environment variables (do NOT use a .env file)
# 2. Railway will inject these at runtime
#
# For local production testing:
# 1. Copy to .env.production
# 2. Run: gunicorn thuvienso_backend.wsgi

# === DJANGO CORE SETTINGS ===
DEBUG=False
ENVIRONMENT=production
SECRET_KEY=your-secret-key-here-GENERATE-WITH-python-m-django-shell

# Allow these hosts (comma-separated, no spaces)
# For GitHub Pages: yourusername.github.io
# For custom domain: yourdomain.com,www.yourdomain.com
# For Railway: your-app.up.railway.app
ALLOWED_HOSTS=yourusername.github.io,yourdomain.railway.app

# Railway-specific (set by Railway, but included for documentation)
RAILWAY_DOMAIN=your-app.up.railway.app

# === DATABASE ===
# Railway will provide: postgresql://user:password@host:port/dbname
# Generated in Railway PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/railway

# === FRONTEND CORS ===
# URLs where the frontend is deployed (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=https://yourusername.github.io/thuvienso,https://yourdomain.com

# === JWT SETTINGS ===
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# === EMAIL CONFIGURATION ===
# Option 1: Gmail SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password  # Use app password, not account password
DEFAULT_FROM_EMAIL=noreply@thuvienso.local

# Option 2: SendGrid (uncomment if using)
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=your-sendgrid-api-key

# === SECURITY SETTINGS ===
# These are set in settings.py when DEBUG=False, but documented here
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000  # 1 year

# === AWS S3 (Optional - for media file storage) ===
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# === REDIS (Optional - for caching) ===
REDIS_URL=

# === ERROR TRACKING (Optional - Sentry) ===
SENTRY_DSN=

# === LOGGING ===
LOG_LEVEL=INFO

# === API CONFIGURATION ===
API_PAGINATION_SIZE=20
API_RATE_LIMIT=1000/hour

# === MONITORING ===
# Healthcheck configuration (Railway uses /health/ endpoint)
HEALTHCHECK_TIMEOUT=10
