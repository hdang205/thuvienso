# === DJANGO CORE CONFIGURATION ===
# Set DEBUG=False in production
DEBUG=True
ENVIRONMENT=development

# Generate a secure key for production using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-secure-secret-key-in-production

# Allowed hosts (comma-separated, without spaces)
ALLOWED_HOSTS=localhost,127.0.0.1

# === DATABASE CONFIGURATION ===
# Default uses local SQLite (db.sqlite3).
# For PostgreSQL (e.g. Railway or local Docker), uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# === FRONTEND CORS & CSRF ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === API BASE URL ===
API_BASE_URL=http://localhost:8000/api
